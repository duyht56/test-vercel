# =============================================================================
# Mobile environment variables.
#
# IMPORTANT — SECURITY:
# - DO NOT put any AI API key here. Mobile bundles can be reverse-engineered.
# - The mobile app talks ONLY to the Next.js backend at EXPO_PUBLIC_API_BASE_URL,
#   which holds the AI key server-side.
#
# Variables prefixed with EXPO_PUBLIC_ are bundled into the JS at build time
# and are visible to anyone who installs the app.
# =============================================================================

# URL of the Next.js backend that proxies AI calls.
# Local dev:  http://localhost:3000   (use your machine's LAN IP from a real device,
#                                      e.g. http://192.168.1.20:3000)
# Production: https://your-vercel-deployment.vercel.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
