# =============================================================================
# Server-side environment variables for the Next.js backend (kid-talk proxy).
#
# IMPORTANT — SECURITY:
# - GEMINI_API_KEY is a SERVER-ONLY secret. NEVER copy this value into the
#   mobile app or any client bundle. The mobile app talks to /api/ai/* on
#   this Next.js server, which then calls Gemini using this key.
# - Locally, copy this file to `.env.local` (which is git-ignored).
# - On Vercel, configure these in Project Settings → Environment Variables.
# =============================================================================

# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Defaults to "gemini-1.5-flash". Other valid values:
#   gemini-1.5-pro     (higher quality, slower, more $)
#   gemini-1.5-flash-8b (faster, cheaper)
GEMINI_MODEL=
